<?xml version="1.0" encoding="UTF-8"?>
<!--
  Voxcell Desktop — WiX v3 installer source (P4-05, fallback if NSIS absent).
  Ready-to-run. build.ps1 invokes:
    candle -dVersion=<v> -dStageDir=<abs stage dir> -out voxcell.wixobj voxcell.wxs
    light  -out dist/windows/Voxcell-<v>-x64.msi voxcell.wixobj
  Manual: install WiX 3.x (choco install wixtoolset -y), then run the two lines
  above from packaging/windows/. Requires staged layout voxcell.exe + assets/**.
  Signing: build.ps1 signs the .msi-embedded exe via signtool when
  VOXCELL_SIGN_CERT + VOXCELL_SIGN_PASSWORD are set (never faked).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?ifndef Version ?>
    <?define Version = "0.1.0" ?>
  <?endif ?>
  <?ifndef StageDir ?>
    <?define StageDir = "..\..\dist\windows\stage\Voxcell-$(var.Version)-x64" ?>
  <?endif ?>

  <Product Id="*" Name="Voxcell" Language="1033" Version="$(var.Version)"
           Manufacturer="Voxcell" UpgradeCode="7E4A1C2D-9B3F-4E6A-8D51-VOXCELL0001">
    <Package InstallerVersion="300" Compressed="yes" InstallScope="perMachine"
             Description="Voxcell Desktop $(var.Version)" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Voxcell is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="Voxcell" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AssetFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Voxcell">
          <Directory Id="AssetsDir" Name="assets" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcutDir" Name="Voxcell" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="VoxcellExe" Guid="*" Win64="yes">
        <File Id="VoxcellExeFile" Source="$(var.StageDir)\voxcell.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- assets/** harvested at authoring time; WiX requires explicit files.
         build.ps1/candle users: regenerate AssetFiles with heat.exe if assets change:
           heat dir <StageDir>\assets -cg AssetFiles -dr AssetsDir -var var.StageDirAssets -ag -sfrag -srd -out assets.wxs
         The list below matches the current assets/ content (fonts + character). -->
    <ComponentGroup Id="AssetFiles" Directory="AssetsDir">
      <Component Id="AssetCharacter" Guid="*" Win64="yes">
        <File Source="$(var.StageDir)\assets\character\portrait_base.png" />
        <File Source="$(var.StageDir)\assets\character\sprite_sheet.png" />
      </Component>
      <Component Id="AssetFonts" Guid="*" Win64="yes">
        <File Source="$(var.StageDir)\assets\fonts\PlusJakartaSans[wght].ttf" />
        <File Source="$(var.StageDir)\assets\fonts\Archivo[wdth,wght].ttf" />
        <File Source="$(var.StageDir)\assets\fonts\JetBrainsMono[wght].ttf" />
        <File Source="$(var.StageDir)\assets\fonts\OFL-plusjakartasans.txt" />
        <File Source="$(var.StageDir)\assets\fonts\OFL-archivo.txt" />
        <File Source="$(var.StageDir)\assets\fonts\OFL-jetbrainsmono.txt" />
      </Component>
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="AppShortcutDir" Guid="*" Win64="yes">
      <Shortcut Id="AppStartMenu" Name="Voxcell" Target="[INSTALLFOLDER]voxcell.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="AppDesktop" Directory="DesktopFolder" Name="Voxcell"
                Target="[INSTALLFOLDER]voxcell.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Voxcell" Name="installed" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>
  </Product>
</Wix>
